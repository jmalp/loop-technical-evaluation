{
  "name": "loop-technical-evaluation",
  "version": "1.0.0",
  "private": true,
  "description": "Data-driven Playwright and TypeScript suite for Loop's 2025 technical evaluation.",
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
